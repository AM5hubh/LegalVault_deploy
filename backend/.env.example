# Environment variables for SBBDEMS backend
JWT_SECRET=your_jwt_secret_here
MONGO_URI=mongodb://localhost:27017/sbbdems
INFURA_URL=https://sepolia.infura.io/v3/your_infura_key
PRIVATE_KEY=your_ethereum_private_key
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_email
SMTP_PASS=your_smtp_app_password
FROM_EMAIL=your_smtp_email
SANDBOX_API_KEY=your_sandbox_api_key
PORT=5000
# Comma-separated allowed frontend origins in production
CORS_ORIGIN=https://legalvault-1.onrender.com
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
